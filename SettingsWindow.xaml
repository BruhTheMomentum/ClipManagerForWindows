<Window x:Class="ClipManagerForWindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clip Manager - Settings" Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="10"
            Background="{DynamicResource PopupBackgroundBrush}"
            BorderBrush="{DynamicResource PopupBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.5" ShadowDepth="4" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with close button -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Settings"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{DynamicResource SubtleButtonStyle}"
                        Padding="8,6"
                        BorderThickness="0"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TrayScrollBar}"/>
                </ScrollViewer.Resources>

                <StackPanel>

                    <!-- Startup -->
                    <Border Style="{DynamicResource SettingsSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="STARTUP" Style="{DynamicResource SettingsSectionTitle}"/>
                            <CheckBox x:Name="LaunchOnStartupCheckBox"
                                      Content="Launch on Windows startup"
                                      Style="{DynamicResource ThemedCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border Style="{DynamicResource SettingsSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="HISTORY" Style="{DynamicResource SettingsSectionTitle}"/>

                            <TextBlock Text="Maximum stored entries" Style="{DynamicResource SettingsLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MaxEntriesTextBox" Style="{DynamicResource ThemedTextBox}"/>
                                <TextBlock Grid.Column="1"
                                           Text="entries"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Retention period (0 = forever)" Style="{DynamicResource SettingsLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RetentionDaysTextBox" Style="{DynamicResource ThemedTextBox}"/>
                                <TextBlock Grid.Column="1"
                                           Text="days"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>

                            <Button x:Name="ClearAllButton"
                                    Content="Clear All History"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Hotkeys -->
                    <Border Style="{DynamicResource SettingsSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS" Style="{DynamicResource SettingsSectionTitle}"/>
                            <TextBlock Text="Show history window" Style="{DynamicResource SettingsLabel}"/>
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="10,8" HorizontalAlignment="Left">
                                <TextBlock x:Name="HotkeyDisplayTextBlock"
                                           Text="Ctrl+Shift+V"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Hotkey customization coming soon" Style="{DynamicResource SettingsHint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border Style="{DynamicResource SettingsSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="NOTIFICATIONS" Style="{DynamicResource SettingsSectionTitle}"/>
                            <CheckBox x:Name="ShowTruncationNotificationsCheckBox"
                                      Content="Show notifications when content is truncated"
                                      IsChecked="True"
                                      Style="{DynamicResource ThemedCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Appearance -->
                    <Border Style="{DynamicResource SettingsSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{DynamicResource SettingsSectionTitle}"/>
                            <TextBlock Text="Theme" Style="{DynamicResource SettingsLabel}"/>
                            <ComboBox x:Name="ThemeComboBox" Width="200" HorizontalAlignment="Left"
                                      Style="{DynamicResource ThemedComboBox}"
                                      ItemContainerStyle="{DynamicResource ThemedComboBoxItem}"
                                      SelectionChanged="OnThemeSelectionChanged">
                                <ComboBoxItem Content="System"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Danger Zone -->
                    <Border Background="{DynamicResource DangerZoneBackgroundBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                            BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DANGER ZONE" Style="{DynamicResource SettingsSectionTitle}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <Button x:Name="RemoveEntirelyButton"
                                    Content="Remove Entirely"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    HorizontalAlignment="Left"/>
                            <TextBlock Text="Completely remove ClipManager including all data and settings."
                                       Style="{DynamicResource SettingsHint}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                        Style="{DynamicResource SubtleButtonStyle}" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="Save" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
