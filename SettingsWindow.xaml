<Window x:Class="ClipManagerForWindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clip Manager - Settings" Height="600" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Startup -->
                <GroupBox Header="Startup" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="LaunchOnStartupCheckBox" Content="Launch on Windows startup" />
                    </StackPanel>
                </GroupBox>

                <!-- History -->
                <GroupBox Header="History" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="Maximum stored entries:" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="MaxEntriesTextBox" Width="100" Margin="0,0,10,0"/>
                            <TextBlock Text="entries" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Retention period (days, 0 = forever):" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="RetentionDaysTextBox" Width="100" Margin="0,0,10,0"/>
                            <TextBlock Text="days" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="ClearAllButton" Content="Clear All History" Background="IndianRed" Foreground="White"/>
                    </StackPanel>
                </GroupBox>

                <!-- Hotkeys -->
                <GroupBox Header="Hotkeys" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="Show history window:" Margin="0,0,0,5"/>
                        <TextBlock x:Name="HotkeyDisplayTextBlock" Text="Ctrl+Shift+V" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="(Hotkey customization coming soon)" FontStyle="Italic" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <!-- Notifications -->
                <GroupBox Header="Notifications" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="ShowTruncationNotificationsCheckBox" Content="Show notifications when content is truncated" IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Theme -->
                <GroupBox Header="Appearance" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="Theme:" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ThemeComboBox" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="System" IsSelected="True"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                        <TextBlock Text="(Theme support coming soon)" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Danger Zone -->
                <GroupBox Header="Danger Zone" Margin="0,0,0,15" BorderBrush="IndianRed">
                    <StackPanel Margin="10">
                        <TextBlock Text="⚠️ Destructive Actions" FontWeight="Bold" Foreground="IndianRed" Margin="0,0,0,10"/>
                        <Button x:Name="RemoveEntirelyButton" Content="🗑️ Remove Entirely"
                                Background="IndianRed" Foreground="White"
                                Width="150" HorizontalAlignment="Left"/>
                        <TextBlock Text="This will completely remove ClipManagerForWindows including all data and settings."
                                   FontStyle="Italic" Foreground="Gray" FontSize="11"
                                   Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
