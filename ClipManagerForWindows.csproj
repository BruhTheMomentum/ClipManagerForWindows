<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>Assets\clip.ico</ApplicationIcon>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>
		
			<ItemGroup>
				<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.10" />
				<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
				<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
				<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
				<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
			</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="ViewModels\" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Assets\clip.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include=".github\workflows\dotnet-desktop.yml" />
	</ItemGroup>

</Project>
